# GEMINI AI API KEY (Required for Mind Lab AI Scenario Simulator)
VITE_GEMINI_API_KEY=

# Optional Application Logo URL
VITE_APP_LOGO_URL=

# FIREBASE CONFIGURATION (For Vercel / Production Deployment)
