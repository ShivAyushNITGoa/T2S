# ==========================================================
# Talk2Society (T2S) — Firebase Environment Configuration
# Copy this file to `.env` for local overrides, or add these
# keys in your Vercel Project -> Settings -> Environment Variables.
# (If omitted, the app automatically uses firebase-applet-config.json)
# ==========================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIRESTORE_DATABASE_ID=(default)
