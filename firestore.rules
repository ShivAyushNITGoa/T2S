rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
             (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
              (request.auth.token.email == 'shivshivamxyz@gmail.com' && request.auth.token.email_verified == true)); 
    }
    function isStrategist() {
      return isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStrategist == true);
    }

   function isValidUser(data) {
      return data.keys().hasAll(['email', 'xp', 'level', 'completedDays', 'updatedAt']) &&
             data.email is string && data.email.size() <= 200 &&
             data.xp is int && data.xp >= 0 &&
             data.level is int && data.level >= 1 &&
             data.completedDays is list && data.completedDays.size() <= 100 &&
             (data.get('presenceDays', []) is list) &&
             (data.get('streak', 0) is int) &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('bio', '') is string && data.get('bio', '').size() <= 500) &&
             (data.get('uid', '') is string) &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2000000) && // Allow for large base64 if needed, though 800KB is the UI limit
             (data.get('referredBy', '') is string) &&
             (data.get('isStrategist', false) is bool) &&
             (data.get('lastLoginAt', request.time) is timestamp || data.get('lastLoginAt', null) == null) &&
             (data.get('updatedAt', request.time) is timestamp);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'level', 'completedDays', 'updatedAt', 'lastLoginAt', 'streak', 'displayName', 'bio', 'photoURL', 'isStrategist', 'presenceDays'])
      )) || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStrategist']));
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'content', 'createdAt', 'likes']) &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             (data.get('authorPhotoURL', null) == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2000000)) &&
             data.content is string && data.content.size() <= 1000 &&
             data.likes is int && data.likes >= 0 &&
             (data.get('likedBy', []) is list);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(request.resource.data);
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) &&
         request.resource.data.likedBy is list &&
         (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1) &&
         (
           (request.resource.data.likes == resource.data.likes + 1 && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() + 1 && request.auth.uid in request.resource.data.likedBy) ||
           (request.resource.data.likes == resource.data.likes - 1 && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() - 1 && !(request.auth.uid in request.resource.data.likedBy))
         )
        ) ||
        (isOwner(resource.data.authorId) && isValidPost(request.resource.data))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data.authorId) || isAdmin());
    }

    // Content Management
    match /journey/{dayId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /archives/{videoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /library/{bookId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /shop/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through Firebase Console for security
    }

    match /test/connection {
      allow get: if true;
    }
  }
}
